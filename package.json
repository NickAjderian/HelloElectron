{
  "name": "helloelectron",
  "version": "1.0.4",
  "description": "my first electron app",
  "keywords": [
    "electron",
    "javascript"
  ],
  "homepage": "https://github.com/NickAjderian/HelloElectron#readme",
  "bugs": {
    "url": "https://github.com/NickAjderian/HelloElectron/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NickAjderian/HelloElectron.git"
  },
  "license": "ISC",
  "author": "nick",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "test": "node test",
    "start": "electron-forge start",
    "build": "electron-builder --dir",
    "release": "electron-builder --publish always",
    "dist": "electron-builder",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "msnodesqlv8": "^5.5.0",
    "mssql": "^12.7.2",
    "tedious": "^20.0.0",
    "update-electron-app": "^3.3.0"
  },
  "build": {
    "appId": "net.flikk.helloelectron",
    "productName": "HelloElectron",
    "publish": {
      "provider": "github",
      "owner": "nickajderian",
      "repo": "helloelectron"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!local.settings.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
